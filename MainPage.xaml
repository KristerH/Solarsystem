<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Solarsystem.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">

        <!-- 3D-vyn -->
        <GraphicsView x:Name="SpaceView" Grid.Row="0">
            <GraphicsView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Klocka och hjälptext ovanpå vyn -->
        <VerticalStackLayout Grid.Row="0"
                             Margin="14"
                             Spacing="2"
                             HorizontalOptions="Start"
                             VerticalOptions="Start"
                             InputTransparent="True">
            <Label x:Name="DateLabel" TextColor="White" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="ElapsedLabel" TextColor="#9EC1E8" FontSize="14" />
            <Label x:Name="MissionLabel" TextColor="#8FD3B6" FontSize="14" Margin="0,4,0,0" />
            <Label TextColor="#5E6E80" FontSize="12"
                   Text="Dra med musen = rotera &#8226; Skrollhjul = zooma &#8226; Piltangenter = rotera &#8226; W/S = zooma &#8226; Mellanslag = starta/pausa &#8226; R = återställ vyn" />

            <!-- Färdpanelen: syns bara medan en farkost är i väg eller framme. -->
            <Border x:Name="MissionPanel"
                    IsVisible="False"
                    Margin="0,12,0,0"
                    Padding="12,9"
                    HorizontalOptions="Start"
                    BackgroundColor="#C6101822"
                    Stroke="#2A3F52"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="3">
                    <Label x:Name="CraftTitleLabel" TextColor="#E8F4FF" FontSize="15"
                           FontAttributes="Bold" Margin="0,0,0,3" />
                    <Label x:Name="CraftElapsedLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="CraftRemainingLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="CraftDistanceLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="CraftSpeedLabel" TextColor="#8FD3B6" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Sondpanelen: syns när en rymdsond är vald i fokusväljaren. -->
            <Border x:Name="ProbePanel"
                    IsVisible="False"
                    Margin="0,12,0,0"
                    Padding="12,9"
                    HorizontalOptions="Start"
                    BackgroundColor="#C6101822"
                    Stroke="#2A3F52"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="3">
                    <Label x:Name="ProbeTitleLabel" TextColor="#E8F4FF" FontSize="15"
                           FontAttributes="Bold" Margin="0,0,0,3" />
                    <Label x:Name="ProbeDistanceLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="ProbeSpeedLabel" TextColor="#8FD3B6" FontSize="13" />
                    <Label x:Name="ProbeLastLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="ProbeNextLabel" TextColor="#7E93A8" FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Kontrollpanel. Två fasta rader i en horisontell ScrollView i stället
             för FlexLayout med Wrap – FlexLayout kan hamna i en oändlig
             mätloop när fönsterbredden ändras, vilket frös hela appen. -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never"
                    BackgroundColor="#12161C">
            <VerticalStackLayout Padding="12,8" Spacing="6">

                <HorizontalStackLayout Spacing="6">
                    <Button x:Name="StartStopButton"
                            Text="&#9208; Pausa"
                            Clicked="OnStartStopClicked"
                            BackgroundColor="#2E4A66"
                            TextColor="White"
                            Margin="0,0,10,0"
                            WidthRequest="120" />

                    <Label Text="Hastighet:" TextColor="#C8D4E0" VerticalOptions="Center" />
                    <!-- Skalan går från -1 till 1: mitten står still, vänster halva
                         spelar tiden baklänges. 0,25 = 1 dygn/sekund framåt. -->
                    <Slider x:Name="SpeedSlider"
                            Minimum="-1" Maximum="1" Value="0.25"
                            WidthRequest="220"
                            VerticalOptions="Center"
                            ValueChanged="OnSpeedChanged" />
                    <Label x:Name="SpeedLabel" TextColor="#C8D4E0" WidthRequest="150"
                           VerticalOptions="Center" Margin="0,0,10,0" />

                    <CheckBox x:Name="OrbitsCheck" IsChecked="True" CheckedChanged="OnOrbitsChanged" Color="#6FA8DC" />
                    <Label Text="Visa banor" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                    <CheckBox x:Name="MoonsCheck" IsChecked="True" CheckedChanged="OnMoonsChanged" Color="#6FA8DC" />
                    <Label Text="Visa månar" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                    <CheckBox x:Name="RealScaleCheck" IsChecked="False" CheckedChanged="OnRealScaleChanged" Color="#6FA8DC" />
                    <Label Text="Verklig storlek" TextColor="#C8D4E0" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6">
                    <CheckBox x:Name="AsteroidsCheck" IsChecked="False" CheckedChanged="OnAsteroidsChanged" Color="#6FA8DC" />
                    <Label Text="Asteroidbälte" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                    <CheckBox x:Name="KuiperCheck" IsChecked="False" CheckedChanged="OnKuiperChanged" Color="#6FA8DC" />
                    <Label Text="Kuiperbälte" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                    <CheckBox x:Name="ProbesCheck" IsChecked="True" CheckedChanged="OnProbesChanged" Color="#6FA8DC" />
                    <Label Text="Rymdsonder" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                    <CheckBox x:Name="ConstellationsCheck" IsChecked="True" CheckedChanged="OnConstellationsChanged" Color="#6FA8DC" />
                    <Label Text="Stjärnbilder" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                    <CheckBox x:Name="StarNamesCheck" IsChecked="False" CheckedChanged="OnStarNamesChanged" Color="#6FA8DC" />
                    <Label Text="Stjärnnamn" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                    <Label Text="Stjärnor:" TextColor="#C8D4E0" VerticalOptions="Center" />
                    <Picker x:Name="StarDensityPicker"
                            TextColor="White"
                            BackgroundColor="#1C2430"
                            WidthRequest="110"
                            SelectedIndexChanged="OnStarDensityChanged"
                            Margin="0,0,10,0" />

                    <Label Text="Fokus:" TextColor="#C8D4E0" VerticalOptions="Center" />
                    <Picker x:Name="FocusPicker"
                            TextColor="White"
                            BackgroundColor="#1C2430"
                            WidthRequest="150"
                            SelectedIndexChanged="OnFocusChanged"
                            Margin="0,0,10,0" />

                    <Button Text="Återställ vy"
                            Clicked="OnResetClicked"
                            BackgroundColor="#26303C"
                            TextColor="White" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6">
                    <Label Text="Datum:" TextColor="#C8D4E0" VerticalOptions="Center" />
                    <Entry x:Name="DateEntry"
                           Placeholder="ÅÅÅÅ-MM-DD"
                           PlaceholderColor="#5E6E80"
                           TextColor="White"
                           BackgroundColor="#1C2430"
                           WidthRequest="140"
                           VerticalOptions="Center"
                           Completed="OnDateEntryCompleted" />
                    <Button Text="Gå dit" Clicked="OnGoToDateClicked"
                            BackgroundColor="#2E4A66" TextColor="White" Margin="0,0,10,0" />

                    <Button Text="‹‹ År" CommandParameter="y-" Clicked="OnStepDateClicked"
                            BackgroundColor="#26303C" TextColor="White" WidthRequest="70" />
                    <Button Text="‹ Mån" CommandParameter="m-" Clicked="OnStepDateClicked"
                            BackgroundColor="#26303C" TextColor="White" WidthRequest="75" />
                    <Button Text="‹ Dag" CommandParameter="d-" Clicked="OnStepDateClicked"
                            BackgroundColor="#26303C" TextColor="White" WidthRequest="70" />
                    <Button Text="Idag" Clicked="OnTodayClicked"
                            BackgroundColor="#2E4A66" TextColor="White" WidthRequest="70" />
                    <Button Text="Dag ›" CommandParameter="d+" Clicked="OnStepDateClicked"
                            BackgroundColor="#26303C" TextColor="White" WidthRequest="70" />
                    <Button Text="Mån ›" CommandParameter="m+" Clicked="OnStepDateClicked"
                            BackgroundColor="#26303C" TextColor="White" WidthRequest="75" />
                    <Button Text="År ››" CommandParameter="y+" Clicked="OnStepDateClicked"
                            BackgroundColor="#26303C" TextColor="White" WidthRequest="70" />

                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6">
                    <Label Text="Rymdfärd:" TextColor="#C8D4E0" VerticalOptions="Center"
                           Margin="0,0,4,0" />

                    <Button x:Name="LaunchButton"
                            Text="Skjut upp mot Mars"
                            Clicked="OnLaunchClicked"
                            BackgroundColor="#2E5A4A" TextColor="White" />
                    <Button x:Name="NextWindowButton"
                            Text="Nästa startfönster"
                            Clicked="OnNextWindowClicked"
                            BackgroundColor="#26303C" TextColor="White" Margin="6,0,0,0" />
                    <Button x:Name="MoonButton"
                            Text="Skjut upp mot Månen"
                            Clicked="OnMoonLaunchClicked"
                            BackgroundColor="#2E5A4A" TextColor="White" Margin="6,0,0,0" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
