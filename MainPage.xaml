<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Solarsystem.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto">

        <!-- The 3D view -->
        <GraphicsView x:Name="SpaceView" Grid.Row="0">
            <GraphicsView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Clock and help text over the view -->
        <VerticalStackLayout Grid.Row="0"
                             Margin="14"
                             Spacing="2"
                             HorizontalOptions="Start"
                             VerticalOptions="Start"
                             InputTransparent="True">
            <Label x:Name="DateLabel" TextColor="White" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="ElapsedLabel" TextColor="#9EC1E8" FontSize="14" />
            <Label x:Name="MissionLabel" TextColor="#8FD3B6" FontSize="14" Margin="0,4,0,0" />
            <!-- The texts are set from the code, see ApplyLanguage in MainPage.xaml.cs.
                 That's why every label and button has a name but no Text here:
                 the language can be switched while the app runs, and everything
                 needs to be reachable when it does. -->
            <Label x:Name="HelpLabel" TextColor="#5E6E80" FontSize="12" />

            <!-- The mission panel: shown only while a craft is en route or has arrived. -->
            <Border x:Name="MissionPanel"
                    IsVisible="False"
                    Margin="0,12,0,0"
                    Padding="12,9"
                    HorizontalOptions="Start"
                    BackgroundColor="#C6101822"
                    Stroke="#2A3F52"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="3">
                    <Label x:Name="CraftTitleLabel" TextColor="#E8F4FF" FontSize="15"
                           FontAttributes="Bold" Margin="0,0,0,3" />
                    <Label x:Name="CraftElapsedLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="CraftRemainingLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="CraftDistanceLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="CraftSpeedLabel" TextColor="#8FD3B6" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- The probe panel: shown when a spacecraft is selected in the focus selector. -->
            <Border x:Name="ProbePanel"
                    IsVisible="False"
                    Margin="0,12,0,0"
                    Padding="12,9"
                    HorizontalOptions="Start"
                    BackgroundColor="#C6101822"
                    Stroke="#2A3F52"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="3">
                    <Label x:Name="ProbeTitleLabel" TextColor="#E8F4FF" FontSize="15"
                           FontAttributes="Bold" Margin="0,0,0,3" />
                    <Label x:Name="ProbeDistanceLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="ProbeSpeedLabel" TextColor="#8FD3B6" FontSize="13" />
                    <Label x:Name="ProbeLastLabel" TextColor="#9EC1E8" FontSize="13" />
                    <Label x:Name="ProbeNextLabel" TextColor="#7E93A8" FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- The probe selector, unfolded from the button in the control panel.
             Sits outside the text stack above, which is click-through. -->
        <Border x:Name="ProbeMenu"
                Grid.Row="0"
                IsVisible="False"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="14,0,0,12"
                Padding="14,10"
                BackgroundColor="#F2121820"
                Stroke="#33445A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="5">
                <HorizontalStackLayout Spacing="6" Margin="0,0,0,4">
                    <Label x:Name="ProbeMenuTitleLabel" TextColor="#E8F4FF" FontSize="14"
                           FontAttributes="Bold" VerticalOptions="Center"
                           Margin="0,0,8,0" />
                    <Button x:Name="AllProbesButton" Clicked="OnAllProbesClicked"
                            BackgroundColor="#26303C" TextColor="White"
                            FontSize="12" Padding="10,2" HeightRequest="30" />
                    <Button x:Name="NoProbesButton" Clicked="OnNoProbesClicked"
                            BackgroundColor="#26303C" TextColor="White"
                            FontSize="12" Padding="10,2" HeightRequest="30" />
                </HorizontalStackLayout>
                <VerticalStackLayout x:Name="ProbeMenuItems" Spacing="2" />
            </VerticalStackLayout>
        </Border>

        <!-- Control panel. The rows sit in a horizontal ScrollView instead of a
             FlexLayout with Wrap – FlexLayout could end up in an infinite
             measuring loop when the window width changed, which froze the
             whole app.

             A narrow bar on top that's always visible, with the button that
             collapses the rest. The panel has grown to five rows and would
             otherwise take up a fifth of the window even when all you want to
             do is look. -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" BackgroundColor="#12161C">

            <Button x:Name="PanelToggleButton"
                    Grid.Row="0"
                    Clicked="OnPanelToggleClicked"
                    BackgroundColor="#12161C"
                    TextColor="#8C99A8"
                    FontSize="12"
                    Padding="10,0"
                    HeightRequest="24"
                    HorizontalOptions="Start" />

            <!-- The language selector sits in the bar and not in the panel, so it
                 stays reachable even when the controls are collapsed. Someone
                 who opens the app in the wrong language shouldn't have to hunt
                 for it. -->
            <HorizontalStackLayout Grid.Row="0" Spacing="6"
                                   HorizontalOptions="End" Margin="0,0,12,0">
                <Label x:Name="LanguageTitleLabel" TextColor="#8C99A8" FontSize="12"
                       VerticalOptions="Center" />
                <Picker x:Name="LanguagePicker"
                        TextColor="#C8D4E0"
                        BackgroundColor="#12161C"
                        FontSize="12"
                        WidthRequest="150"
                        SelectedIndexChanged="OnLanguageChanged" />
            </HorizontalStackLayout>

            <ScrollView x:Name="PanelBody"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never"
                        BackgroundColor="#12161C">
                <VerticalStackLayout Padding="12,8" Spacing="6">

                    <HorizontalStackLayout Spacing="6">
                        <Button x:Name="StartStopButton"
                                Clicked="OnStartStopClicked"
                                BackgroundColor="#2E4A66"
                                TextColor="White"
                                Margin="0,0,10,0"
                                WidthRequest="120" />

                        <Label x:Name="SpeedTitleLabel" TextColor="#C8D4E0" VerticalOptions="Center" />
                        <!-- The scale runs from -1 to 1: the middle stands still, the
                             left half plays time backward. 0.25 = 1 day/second forward. -->
                        <Slider x:Name="SpeedSlider"
                                Minimum="-1" Maximum="1" Value="0.25"
                                WidthRequest="220"
                                VerticalOptions="Center"
                                ValueChanged="OnSpeedChanged" />
                        <Label x:Name="SpeedLabel" TextColor="#C8D4E0" WidthRequest="150"
                               VerticalOptions="Center" Margin="0,0,10,0" />

                        <CheckBox x:Name="OrbitsCheck" IsChecked="True" CheckedChanged="OnOrbitsChanged" Color="#6FA8DC" />
                        <Label x:Name="OrbitsLabel" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                        <CheckBox x:Name="MoonsCheck" IsChecked="True" CheckedChanged="OnMoonsChanged" Color="#6FA8DC" />
                        <Label x:Name="MoonsLabel" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                        <CheckBox x:Name="RealScaleCheck" IsChecked="False" CheckedChanged="OnRealScaleChanged" Color="#6FA8DC" />
                        <Label x:Name="RealScaleLabel" TextColor="#C8D4E0" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <CheckBox x:Name="AsteroidsCheck" IsChecked="False" CheckedChanged="OnAsteroidsChanged" Color="#6FA8DC" />
                        <Label x:Name="AsteroidsLabel" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                        <CheckBox x:Name="KuiperCheck" IsChecked="False" CheckedChanged="OnKuiperChanged" Color="#6FA8DC" />
                        <Label x:Name="KuiperLabel" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                        <CheckBox x:Name="HalleyCheck" IsChecked="False" CheckedChanged="OnHalleyChanged" Color="#6FA8DC" />
                        <Label x:Name="HalleyLabel" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                        <Button x:Name="ProbeMenuButton"
                                Clicked="OnProbeMenuClicked"
                                BackgroundColor="#26303C" TextColor="White"
                                Margin="0,0,10,0" />

                        <CheckBox x:Name="ConstellationsCheck" IsChecked="True" CheckedChanged="OnConstellationsChanged" Color="#6FA8DC" />
                        <Label x:Name="ConstellationsLabel" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                        <CheckBox x:Name="StarNamesCheck" IsChecked="False" CheckedChanged="OnStarNamesChanged" Color="#6FA8DC" />
                        <Label x:Name="StarNamesLabel" TextColor="#C8D4E0" VerticalOptions="Center" Margin="0,0,10,0" />

                        <Label x:Name="StarsTitleLabel" TextColor="#C8D4E0" VerticalOptions="Center" />
                        <Picker x:Name="StarDensityPicker"
                                TextColor="White"
                                BackgroundColor="#1C2430"
                                WidthRequest="110"
                                SelectedIndexChanged="OnStarDensityChanged"
                                Margin="0,0,10,0" />

                        <Label x:Name="FocusTitleLabel" TextColor="#C8D4E0" VerticalOptions="Center" />
                        <Picker x:Name="FocusPicker"
                                TextColor="White"
                                BackgroundColor="#1C2430"
                                WidthRequest="150"
                                SelectedIndexChanged="OnFocusChanged"
                                Margin="0,0,10,0" />

                        <Button x:Name="ResetButton"
                                Clicked="OnResetClicked"
                                BackgroundColor="#26303C"
                                TextColor="White" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Label x:Name="DateTitleLabel" TextColor="#C8D4E0" VerticalOptions="Center" />
                        <Entry x:Name="DateEntry"
                               PlaceholderColor="#5E6E80"
                               TextColor="White"
                               BackgroundColor="#1C2430"
                               WidthRequest="140"
                               VerticalOptions="Center"
                               Completed="OnDateEntryCompleted" />
                        <Button x:Name="GoToDateButton" Clicked="OnGoToDateClicked"
                                BackgroundColor="#2E4A66" TextColor="White" Margin="0,0,10,0" />

                        <Button x:Name="StepYearBackButton" CommandParameter="y-" Clicked="OnStepDateClicked"
                                BackgroundColor="#26303C" TextColor="White" WidthRequest="80" />
                        <Button x:Name="StepMonthBackButton" CommandParameter="m-" Clicked="OnStepDateClicked"
                                BackgroundColor="#26303C" TextColor="White" WidthRequest="85" />
                        <Button x:Name="StepDayBackButton" CommandParameter="d-" Clicked="OnStepDateClicked"
                                BackgroundColor="#26303C" TextColor="White" WidthRequest="80" />
                        <Button x:Name="TodayButton" Clicked="OnTodayClicked"
                                BackgroundColor="#2E4A66" TextColor="White" WidthRequest="75" />
                        <Button x:Name="StepDayForwardButton" CommandParameter="d+" Clicked="OnStepDateClicked"
                                BackgroundColor="#26303C" TextColor="White" WidthRequest="80" />
                        <Button x:Name="StepMonthForwardButton" CommandParameter="m+" Clicked="OnStepDateClicked"
                                BackgroundColor="#26303C" TextColor="White" WidthRequest="85" />
                        <Button x:Name="StepYearForwardButton" CommandParameter="y+" Clicked="OnStepDateClicked"
                                BackgroundColor="#26303C" TextColor="White" WidthRequest="80" />

                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Label x:Name="MissionTitleLabel" TextColor="#C8D4E0" VerticalOptions="Center"
                               Margin="0,0,4,0" />

                        <Button x:Name="LaunchButton"
                                Clicked="OnLaunchClicked"
                                BackgroundColor="#2E5A4A" TextColor="White" />
                        <Button x:Name="NextWindowButton"
                                Clicked="OnNextWindowClicked"
                                BackgroundColor="#26303C" TextColor="White" Margin="6,0,0,0" />
                        <Button x:Name="MoonButton"
                                Clicked="OnMoonLaunchClicked"
                                BackgroundColor="#2E5A4A" TextColor="White" Margin="6,0,0,0" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Label x:Name="MeetingsTitleLabel" TextColor="#C8D4E0" VerticalOptions="Center"
                               Margin="0,0,4,0" />

                        <Picker x:Name="MeetingPicker"
                                TextColor="White"
                                BackgroundColor="#1C2430"
                                WidthRequest="190" />
                        <Button x:Name="MeetingButton"
                                Clicked="OnNextMeetingClicked"
                                BackgroundColor="#26303C" TextColor="White" Margin="6,0,0,0" />
                        <CheckBox x:Name="MoonOrbitCheck"
                                  Color="#7FB4E8"
                                  CheckedChanged="OnMoonOrbitChanged"
                                  Margin="10,0,0,0" />
                        <Label x:Name="MoonOrbitLabel" TextColor="#C8D4E0" VerticalOptions="Center" />

                        <Label x:Name="MeetingLabel"
                               TextColor="#9FB4C8" VerticalOptions="Center" Margin="8,0,0,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
